# Required. Generate one with: openssl rand -base64 48
SECRET_KEY=

# Comma separated list of host names the server may be reached at, e.g. clip.example.com
ALLOWED_HOSTS=*

# Host address and port the app container is published on.
# Keep it on 127.0.0.1 when running behind a reverse proxy on the same machine.
BIND=127.0.0.1:9999

# Built-in HTTPS via Caddy: uncomment both lines and point your domain's DNS at this machine.
# Ports 80 and 443 must be reachable from the internet for Let's Encrypt.
# COMPOSE_PROFILES=caddy
# DOMAIN=clip.example.com

# Only needed if logging in via the web frontend fails with a CSRF error behind your own
# reverse proxy (i.e. it doesn't send X-Forwarded-Proto), e.g. https://clip.example.com
# CSRF_TRUSTED_ORIGINS=

# GUNICORN_WORKERS=2
# LOG_LEVEL=WARNING
# DEBUG=false
